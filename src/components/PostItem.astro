---
const { post } = Astro.props;
---

<article class="mb-6 border-b border-zinc-200 dark:border-zinc-700 pb-4">
  <h3 class="text-xl font-semibold">{post.title}</h3>
  <p class="mt-1 text-zinc-700 dark:text-zinc-300">{post.description}</p>
  {post.category && (
    <span class="text-xs text-zinc-500 italic">{post.category}</span>
  )}
</article>
