---
import { Image } from 'astro:assets';
import type { Project } from '../pages/projects/projects'
import { kFormatter } from '../utils'
import GithubWhite from '@src/assets/img/github-mark-white.svg';
import GithubBlack from '@src/assets/img/github-mark.svg';

const { projects } = Astro.props;
---

<div class="grid grid-cols-12 gap-5">
  {
    projects.map((project: Project) =>
      <div class="relative col-span-12 sm:col-span-6 lg:col-span-4">
        <!-- Carte Projet avec data-id et class pour JS -->
        <div
          class="project-card border dark:border-zinc-700 rounded-xl shadow-sm p-5 cursor-pointer"
          data-project-id={project.id}
        >
          <!-- Contenu de la carte -->
          <div class="flex justify-between items-center">
            <div class='flex gap-2'>
              {
                (project.tags || []).map((tag: string) => (
                  <span class='border border-zinc-300 dark:border-zinc-700 rounded-2xl text-sm text-zinc-700 dark:text-zinc-300 no-underline px-2 py-0.5 hover:border-zinc-700 dark:hover:border-zinc-300 transition-all duration-700'>
                    {tag}
                  </span>
                ))
              }
            </div>
            {project.stargazers_count !== undefined && (
              <div class='shrink-0'>
                <a
                  href={project.html_url}
                  target="_blank"
                  class='border border-zinc-300 dark:border-zinc-700 rounded-2xl text-xs text-zinc-700 dark:text-zinc-300 no-underline px-2 py-0.5 flex items-center gap-1 hover:border-zinc-700 dark:hover:border-zinc-300 transition-all duration-700'>
                  {/* Github star icons */}
                  {project.stargazers_count} stars
                </a>
              </div>
            )}
          </div>
          <h3 class="font-semibold my-2">{project.name}</h3>
          <div class="line-clamp-2 text-zinc-600 dark:text-zinc-300 mb-4 min-h-[50px]">
            <p>{project.description}</p>
          </div>
        </div>

        <!-- Modale cachée -->
        <div
          id={`modal-${project.id}`}
          class="modal fixed inset-0 z-50 bg-black bg-opacity-60 flex items-center justify-center hidden"
        >
          <div class="bg-white dark:bg-zinc-900 p-6 max-w-xl w-full rounded-xl relative shadow-lg text-sm max-h-[90vh] overflow-auto">
            <button
              class="absolute top-2 right-3 text-xl text-gray-600 hover:text-black dark:text-gray-300"
              data-close-button
            >×</button>

            <h2 class="text-2xl font-bold mb-2">{project.name}</h2>
            <p class="mb-4">{project.description}</p>

            {project.issues && (
              <>
                <h3 class="font-semibold mt-2">Problématiques rencontrées & solutions :</h3>
                <ul class="list-disc ml-5 mt-1">
                  {project.issues.map(issue => <li>{issue}</li>)}
                </ul>
              </>
            )}

            {project.skills && (
              <>
                <h3 class="font-semibold mt-4">Compétences développées :</h3>
                <ul class="list-disc ml-5 mt-1">
                  {project.skills.map(skill => <li>{skill}</li>)}
                </ul>
              </>
            )}

            <div class="mt-5 flex gap-4 flex-wrap">
              {project.demoLink && (
                <a class="underline text-blue-600 hover:text-blue-800" href={project.demoLink} target="_blank">
                  Lien GitHub
                </a>
              )}
              {project.postLink && (
                <a class="underline text-blue-600 hover:text-blue-800" href={project.postLink} target="_blank">
                  Article associé
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    )
  }
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Ouvrir la modale au clic sur la carte
    document.querySelectorAll('.project-card').forEach(card => {
      card.addEventListener('click', () => {
        const cardElement = card as HTMLElement;  // Cast explicite de 'card' en 'HTMLElement'
        const id = cardElement.dataset.projectId; // Accède maintenant à 'dataset'
        const modal = document.getElementById(`modal-${id}`);
        if (modal) {
          modal.classList.remove('hidden');
        }
      });
    });

    // Fermer la modale au clic sur le bouton × ou en dehors de la modale
    document.querySelectorAll('.modal').forEach(modal => {
      modal.addEventListener('click', (e) => {
    if (e.target instanceof HTMLElement && e.target.classList.contains('modal')) {
      modal.classList.add('hidden');
    }
      });
      const closeButton = modal.querySelector('[data-close-button]');
      if (closeButton) {  // Vérifie que le bouton existe
        closeButton.addEventListener('click', () => {
          modal.classList.add('hidden');
        });
      }
    });
  });
</script>
