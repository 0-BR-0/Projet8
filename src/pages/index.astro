---
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import  Ava  from '../assets/img/ava.jpg';
import Prose from '../components/Prose.astro';
import { projects } from './projects/projects';
import ProjectList from '../components/ProjectList.astro'
import PostItem from '../components/PostItem.astro';
import { skills } from './posts/skills.ts';

const topSkills = skills.slice(0, 3);



const top3Projects = projects.slice(0, 3);
---

<BaseLayout title={SITE_TITLE + ' - ' + SITE_TAGLINE} description={SITE_DESCRIPTION}>
	<div class='container'>
		<div class='w-full md:flex md:items-center gap-16 mb-10'>
      <div class="text-pretty leading-9">
        <h1 class="text-4xl font-bold mb-4">Hello 👋, je suis Brice, développeur web basé à Paris, France. </h1>
        <Prose>
          <div class="text-lg">
            <p>Fraîchement diplômé, je maîtrise aussi bien la création d’interfaces modernes avec React que la gestion des services back-end avec Express.</p>
            <p>Je suis actuellement à la recherche d’un poste de développeur web (front-end ou full-stack), au sein d’une équipe dynamique où je pourrai mettre mes compétences en pratique et continuer à progresser.</p>
            <p>Pour me contacter : <strong>ramdani.brice@outlook.com</strong></p>
          </div>
        </Prose>
      </div>
      <Image src={Ava} alt="Brice" width={300} loading="eager" class="rounded-3xl rotate-3 mx-4 md:mx-0"/>
		</div>
		<main>
<div class='mt-6 mb-12'>
  <div class="flex justify-between gap-2 border-b mb-1 dark:border-b-zinc-700">
    <h2 class="text-lg font-bold mb-3">Compétences clés</h2>
    <a href="/posts/" class="inline-block py-2 underline dark:prose-invert">Voir plus &raquo;</a>
  </div>
  <div>
    {
      topSkills.map((skill) => (
        <PostItem post={skill} />
      ))
    }      
  </div>
</div>
<div>
        <div class="flex justify-between gap-2 mb-1">
          <h2 class="text-lg font-bold mb-3">Mes Projets</h2>
          <a href="/projects/" class="inline-block py-2 underline dark:prose-invert">Voir plus &raquo;</a>
        </div>
        <ProjectList projects={top3Projects}/>
      </div>
		</main>
	</div>
</BaseLayout>
